# PostgreSQL 16+ for local development. The password below is local-only placeholder data.
POSTGRES_DATABASE_URL="postgresql://wasteops:wasteops_dev@localhost:5432/wasteops?schema=public"

# Optional migration-only role URL for isolated local testing. The gated migration path also
# checks that it targets the same database as POSTGRES_DATABASE_URL and never passes it to Next.js.
# POSTGRES_MIGRATION_DATABASE_URL=

# Generate a unique secret with: openssl rand -base64 32
AUTH_SECRET="replace-with-a-unique-random-value-for-local-development"

# Plain HTTP on localhost: false/lax. Public HTTPS in embedded Manus Preview: true/none.
# Production defaults to true/lax when these local overrides are absent. Never infer cookie policy from NODE_ENV or an internal proxy request.
AUTH_COOKIE_SECURE="false"
AUTH_COOKIE_SAME_SITE="lax"

# Initial demo seed only. All example.test accounts and records are fictional.
# Use unique passwords of at least 12 characters; this template is not a valid password set.
INITIAL_ADMIN_EMAIL="admin@example.test"
INITIAL_ADMIN_NAME="WasteOps Administrator"
INITIAL_ADMIN_PASSWORD="replace-with-a-unique-strong-password"
INITIAL_SUPERVISOR_EMAIL="supervisor@example.test"
INITIAL_SUPERVISOR_PASSWORD="replace-with-a-unique-strong-password"
INITIAL_COLLECTOR_EMAIL="collector@example.test"
INITIAL_COLLECTOR_PASSWORD="replace-with-a-unique-strong-password"
